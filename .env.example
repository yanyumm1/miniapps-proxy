# ========== miniapps.ai 反代配置 ==========

# 必填：从浏览器 F12 抓的登录 cookie（登录后任意请求里 Cookie 头整段复制）
# 格式示例: "jwt=eyJhbGciOi...; pref-lang=zh-Hans; hasVisitedSite=1"
MINIAPPS_COOKIE=

# 或二选一：从 F12 抓 Authorization: Bearer xxx（填 xxx 即可）
MINIAPPS_TOKEN=

# miniapps 后端模型 id（默认 GPT-6 Astra 主模型，一般不用改）
MINIAPPS_MODEL_ID=f57145fe-a761-4ac4-9cc5-676ac291c433

# 反代网关自身的 API Key（你的客户端填这个）
GATEWAY_API_KEY=miniapps-1234

# 监听端口
PORT=8787